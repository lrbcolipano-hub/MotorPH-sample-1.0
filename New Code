    /**
     * Prompts for and displays basic employee information
     * @return Employee number entered
     */
    public static String getOneEmployee(Scanner sc) {
        System.out.print("Enter Employee #: ");
        String employeeNumber = sc.nextLine().trim();
 
        try (BufferedReader reader = new BufferedReader(new FileReader(EMPLOYEE_FILE))) {
            String line;
            reader.readLine(); // skip header
            
            while ((line = reader.readLine()) != null) {
                String[] employeeRecord = line.split(",(?=([^\"]*\"[^\"]*\")*[^\"]*$)");
                
                if (employeeRecord[0].equals(employeeNumber)) {
                    System.out.println("******************");
                    System.out.println("Employee No.: " + employeeRecord[0]);
                    System.out.println("Employee Name: " + employeeRecord[1] + ", " + employeeRecord[2]);
                    System.out.println("Birthday: " + employeeRecord[3]);
                    System.out.println("******************");
                    return employeeNumber;
                }
            }
            
            System.out.println("Employee does not exist.");
        } catch (IOException e) {
            System.out.println("Error reading file");
        }
 
        return employeeNumber;
    }
 
    /**
     * Processes and displays salary details for one employee for a specific month
     */
    public static void processOneEmployeeSalary(String employeeNo, int month) {
        double hourlyRate = 0;
        double firstCutoffGross = 0;
        double secondCutoffGross = 0;
 
        try {
            // Read hourly rate from employee file
            BufferedReader empReader = new BufferedReader(new FileReader(EMPLOYEE_FILE));
            empReader.readLine(); // skip header
            String line;
            
            while ((line = empReader.readLine()) != null) {
                String[] data = line.split(",(?=([^\"]*\"[^\"]*\")*[^\"]*$)");
                if (data[0].equals(employeeNo)) {
                    hourlyRate = Double.parseDouble(data[18]); // Hourly rate column
                    break;
                }
            }
            empReader.close();
 
            // Calculate hours worked from attendance file
            double[] hoursWorked = calculateMonthlyHours(employeeNo, month);
            firstCutoffGross = hoursWorked[0] * hourlyRate;
            secondCutoffGross = hoursWorked[1] * hourlyRate;
 
            // Display results
            System.out.println("----------------------------");
            System.out.println("Month: " + getMonthName(month));
            
            // First cutoff (no deductions)
            System.out.printf("1st Cutoff Gross Salary: %.2f\n", firstCutoffGross);
            System.out.printf("1st Cutoff Net Salary: %.2f\n", firstCutoffGross);
            
            // Second cutoff (with deductions)
            System.out.printf("2nd Cutoff Gross Salary: %.2f\n", secondCutoffGross);
            calculateAndDisplayNet2(firstCutoffGross, secondCutoffGross);
            System.out.println("----------------------------");
            
        } catch (IOException e) {
            System.out.println("Error reading file.");
        }
    }
 
    /**
     * Calculates total hours worked for both cutoffs in a month
     * @return Array where [0] = first half hours, [1] = second half hours
     */
    public static double[] calculateMonthlyHours(String empId, int month) {
        double firstHalfHours = 0;
        double secondHalfHours = 0;
        DateTimeFormatter timeFormat = DateTimeFormatter.ofPattern("H:mm");
 
        try (BufferedReader br = new BufferedReader(new FileReader(ATTENDANCE_FILE))) {
            String line;
            br.readLine(); // skip header
 
            while ((line = br.readLine()) != null) {
                if (line.trim().isEmpty()) continue;
 
                String[] data = line.split(",");
                
                if (!data[0].equals(empId)) continue;
 
                String[] dateParts = data[3].split("/");
                int recordMonth = Integer.parseInt(dateParts[0]);
                int day = Integer.parseInt(dateParts[1]);
                int year = Integer.parseInt(dateParts[2]);
 
                if (year != 2024 || recordMonth != month) continue;
 
                LocalTime login = LocalTime.parse(data[4].trim(), timeFormat);
                LocalTime logout = LocalTime.parse(data[5].trim(), timeFormat);
 
                double hours = calculateHoursWorked(login, logout);
 
                if (day <= 15) {
                    firstHalfHours += hours;
                } else {
                    secondHalfHours += hours;
                }
            }
 
        } catch (IOException ex) {
            System.out.println("Error reading attendance file");
        }
 
        return new double[]{firstHalfHours, secondHalfHours};
    }
 
    /**
     * Calculates hours worked from login and logout times
     * Applies grace period and caps at 8 hours
     */
    public static double calculateHoursWorked(LocalTime login, LocalTime logout) {
        LocalTime graceTime = LocalTime.of(8, 10);
        LocalTime cutoffTime = LocalTime.of(17, 0);
 
        // Cap logout at official cutoff time
        if (logout.isAfter(cutoffTime)) {
            logout = cutoffTime;
        }
 
        // If on time (within grace period), credit full 8 hours
        if (!login.isAfter(graceTime)) {
            return 8.0;
        }
 
        if (logout.isBefore(login)) {
            return 0;
        }
 
        long minutesWorked = Duration.between(login, logout).toMinutes();
 
        // Deduct lunch break
        if (minutesWorked > 60) {
            minutesWorked -= 60;
        } else {
            minutesWorked = 0;
        }
 
        double hours = minutesWorked / 60.0;
        return Math.min(hours, 8.0);
    }
 
    /**
     * Calculates and displays second cutoff net pay with all deductions
     */
    public static void calculateAndDisplayNet2(double gross1, double gross2) {
        double totalGross = gross1 + gross2;
        
        // Calculate Pag-IBIG
        double pagibig;
        if (totalGross >= 1000 && totalGross <= 1500) {
            pagibig = Math.min(totalGross * 0.01, 100);
        } else if (totalGross > 1500) {
            pagibig = Math.min(totalGross * 0.02, 100);
        } else {
            pagibig = 0;
        }
        
        // Calculate PhilHealth
        double philhealth;
        if (totalGross == 10000) {
            philhealth = (totalGross * 0.03) / 2;
        } else if (totalGross >= 10000.01 && totalGross <= 59999.99) {
            philhealth = (totalGross * 0.03) / 2;
        } else if (totalGross >= 60000) {
            philhealth = totalGross * 0.03;
        } else {
            philhealth = 0;
        }
        
        // Calculate SSS
        double sssDeduction;
        if (totalGross < 3250) {
            sssDeduction = 135;
        } else if (totalGross >= 24750) {
            sssDeduction = 1125;
        } else {
            int bracket = (int) ((totalGross - 3250) / 500);
            sssDeduction = 157.5 + (bracket * 22.5);
        }
        
        double deductions = pagibig + philhealth + sssDeduction;
        double taxable = totalGross - deductions;
        
        // Calculate Tax
        double tax;
        if (taxable < 20833) {
            tax = 0;
        } else if (taxable >= 20833 && taxable < 33333) {
            tax = (taxable - 20833) * 0.20;
        } else if (taxable >= 33333 && taxable < 66667) {
            tax = 2500 + ((taxable - 33333) * 0.25);
        } else if (taxable >= 66667 && taxable < 166667) {
            tax = 10833 + ((taxable - 66667) * 0.30);
        } else if (taxable >= 166667 && taxable < 666667) {
            tax = 40833.33 + ((taxable - 166667) * 0.32);
        } else {
            tax = 200833.33 + ((taxable - 666667) * 0.35);
        }
        
        double totalDeductions = deductions + tax;
        double netpay2 = gross2 - totalDeductions;
        
        // Display breakdown
        System.out.println("Total Gross: " + String.format("%.2f", totalGross));
        System.out.println("Taxable Income: " + String.format("%.2f", taxable));
        System.out.println("Deductions:");
        System.out.println("\tPagibig: " + String.format("%.2f", pagibig));
        System.out.println("\tPhilhealth: " + String.format("%.2f", philhealth));
        System.out.println("\tSSS: " + String.format("%.2f", sssDeduction));
        System.out.println("\tTax: " + String.format("%.2f", tax));
        System.out.println("Total Deductions: " + String.format("%.2f", totalDeductions));
        System.out.println("Net pay 2nd Cut-off: " + String.format("%.2f", netpay2));
    }
 
    /**
     * Processes salary for all employees from June to December
     */
    public static void processAllEmployeesSalary() {
        try (BufferedReader empReader = new BufferedReader(new FileReader(EMPLOYEE_FILE))) {
            String line;
            empReader.readLine(); // skip header
            
            while ((line = empReader.readLine()) != null) {
                if (line.trim().isEmpty()) continue;
                
                String[] data = line.split(",(?=([^\"]*\"[^\"]*\")*[^\"]*$)");
                String employeeID = data[0];
                
                System.out.println("******************");
                System.out.println("Employee No.: " + data[0]);
                System.out.println("Employee Name: " + data[1] + ", " + data[2]);
                System.out.println("Birthday: " + data[3]);
                System.out.println("******************");
                
                for (int month = 6; month <= 12; month++) {
                    processOneEmployeeSalary(employeeID, month);
                }
            }
        } catch (IOException e) {
            System.out.println("Error reading file.");
        }
    }
 
    /**
     * Returns month name for display
     */
    public static String getMonthName(int month) {
        return switch (month) {
            case 6 -> "June";
            case 7 -> "July";
            case 8 -> "August";
            case 9 -> "September";
            case 10 -> "October";
            case 11 -> "November";
            case 12 -> "December";
            default -> "";
        };
    }
