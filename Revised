 */
public class PayrollSystem {
 
    private static final String EMPLOYEE_FILE = "src\\main\\java\\com\\mycompany\\payrollsystem\\MotorPH_Employee Data - Employee Details.csv";
    private static final String ATTENDANCE_FILE = "src\\main\\java\\com\\mycompany\\payrollsystem\\MotorPH_Employee Data - Attendance Record.csv";
    private static final String VALID_PASSWORD = "12345";
    
    // Grace period and work time constants
    private static final LocalTime GRACE_TIME = LocalTime.of(8, 10);
    private static final LocalTime CUTOFF_TIME = LocalTime.of(17, 0);
    private static final int LUNCH_BREAK_MINUTES = 60;
    private static final double STANDARD_WORK_HOURS = 8.0;
 
    public static void main(String[] args) {
